  jmp set_bank
apple_random2:
  ld c, score
  neg c
  rnd d
  ldi b, mod_d_c
mod_d_c:
  sub d, c
  jns b
add d, c
ldi a, 0x3f
random_loop1:
  inc a
  ldi b, 0b10000000
  random_loop2:
    ld c, a
    and c, b
    jnz end_random2
    dec d
    js end_random
  end_random2:
    shr b
    jnc random_loop2
  jmp random_loop1
end_random:
