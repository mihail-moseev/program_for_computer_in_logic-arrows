apple_random:
  ld a, score
  ldi b, 56
  add a, b
  jnc apple_random1
  ldi c, 3
  ldi d, apple_random2
  jmp set_bank
apple_random1:
  rnd a
  ldi c, 7
  and c, a
  ldi b, 0b10000000
  loop:
    shr b
    dec c
    jns loop
  rcl b
  shr a
  shr a
  shr a
  ldi c, 0x40
  add a, c
end_apple_random:
  mov d, a
  ldi c, 0x20
  add d, c
  ld c, d
  and c, b
  jnz apple_random
  st a, apple_adress
  st b, apple_pos
  ld c, a
  or c, b
  st c, a
add_score:
  ld a, score
  inc a
  st a, score
  not a
  jnz add_last_cell
  ldi c, 5
  ldi d, win_start
  jmp set_bank
add_last_cell:
  ld a, last_cell_pos
  ld b, last_cell_adress
  dec a
  dec a
  jns save_last_cell
  ldi a, 6
  inc b
save_last_cell:
  st a, last_cell_pos
  st b, last_cell_adress
key_read:
  ldi c, 2
  ld a, 0x3e
  ld b, lock_key
  xor b, a
  jz key_read
  ldi b, KEY_RIGHT ;key_read + 9
  xor b, a
  jz right
  ldi b, KEY_LEFT
  xor b, a
  jz left
  ldi b, KEY_UP
  xor b, a
  jz up
  ldi b, KEY_DOWN
  xor b, a
  jz down
  ld a, last_key
  jmp key_read + 9
right:
  ldi d, right_start
  jmp set_bank
left:
  ldi d, left_start
  jmp set_bank
up:
  ldi d, up_start
  jmp set_bank
down:
  ldi d, down_start
  jmp set_bank
void2 db 0, 0, 0, 0, 0
right_start:
  st a, last_key
  ldi a, KEY_LEFT
  st a, lock_key
  ld a, head_pos
  ld b, head_adress
  shr a
  jnc next_jmp
  mov c, b
  shr c
  jc game_over
  ldi a, 0b10000000
  inc b
  jmp next_jmp
left_start:
  st a, last_key
  ldi a, KEY_RIGHT
  st a, lock_key
  ld a, head_pos
  ld b, head_adress
  shl a
  jnc next_jmp
  mov c, b
  shr c
  jnc game_over
  ldi a, 0b00000001
  dec b
  jmp next_jmp
up_start:
  st a, last_key
  ldi a, KEY_DOWN
  st a, lock_key
  ld a, head_pos
  ld b, head_adress
  ldi c, 0x60
  xor c, b
  shr c
  jz game_over
  dec b
  dec b
  jmp next_jmp
down_start:
  st a, last_key
  ldi a, KEY_UP
  st a, lock_key
  ld a, head_pos
  ld b, head_adress
  ldi c, 0x7e
  xor c, b
  shr c
  jz game_over
  inc b
  inc b
next_jmp:
  ld c, b
  and c, a
  jnz game_over
  st b, save
  ld c, head_pos
  ld d, head_adress
  ldi b, 0x20
  sub d, b
  ld b, d
  xor b, c
  st b, d
  ld b, save
  st a, head_pos
  st b, head_adress
  ld c, b
  or c, a
  st c, b
  ldi c, 3
  ldi d, next_jmp2
  jmp set_bank
game_over:
  ldi c, 5
  ldi d, game_over_start
  jmp set_bank
void3 db 0, 0, 0, 0, 0, 0, 0, 0, 0
next_jmp2:
  ldi c, 0x20
  sub b, c
  ld c, b
  or c, a
  st c, b
check_collision_apple:
  ld a, head_pos
  ld b, apple_pos
  xor a, b
  jnz jmp_bank_4
  ldi c, 0x20
  ld a, head_adress
  ld b, apple_adress
  add b, c
  xor a, b
  jnz jmp_bank_4
save_new_cell_pos:
  ldi a, other_bank
  st a, next
  ldi a, apple_random
  st a, end_jmp + 1
  ldi c, 4
  ldi d, save_head_cell
